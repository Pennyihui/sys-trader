# 交易系统环境配置模板 — 复制为 config/.env 后填入真实值
# cp config/.env.example config/.env   (config/.env* 已在 .gitignore, 勿提交)

# ── Binance API (testnet 密钥: https://testnet.binancefuture.com/) ──
BINANCE_API_KEY=your_testnet_api_key
BINANCE_API_SECRET=your_testnet_api_secret

# ── 网络代理 (Clash / mihomo, 默认本机 7897) ──
PROXY_HOST=127.0.0.1
PROXY_PORT=7897

# ── Redis (Memurai / Redis, EventBus 依赖) ──
REDIS_URL=redis://localhost:6379

# ── 下单参数 ──
# 签名时间戳接收窗口 (毫秒), 默认 15000 容忍代理延迟波动
RECV_WINDOW=15000
# 全局杠杆上限 (风控链 LeverageController), 默认 5
MAX_LEVERAGE=5
# 执行模式 (OrderManager 构造时读): dry_run / paper / live
# 注: runner 启动参数 --execution-mode 优先于该变量
EXECUTION_MODE=dry_run
# postOnly: 1=入场单走 LIMIT_MAKER 只吃 maker 费率 (0.05%→0.02%)
POST_ONLY=0
# 入场单有效期: GTC=挂单等待成交 / IOC=立即成交否则撤 (2026-08-16 #8)
ENTRY_TIF=GTC
# 部分成交余量策略: wait=保留余量继续等 / cancel=撤余量按已成交建仓 (#9)
PARTIAL_FILL_POLICY=wait

# ── 第七轮补强 (2026-08-16) ──
# 实际手续费率: auto=查 /fapi/v1/commissionRate (2×taker 往返口径) / 显式数字
FEE_RATE=auto
# 爆仓距离告警阈值: 距清算价低于该比例自动减仓 (0=禁用)
LIQ_ALERT_PCT=0.08
# 多资产保证金模式检测: 1=检测并切换可用余额口径
MULTI_ASSETS_CHECK=1
# 强平事件流 (独立 WS): 1=开启 (testnet 可能不支持, 隔离故障域)
FORCE_ORDER_STREAM=0
# 大额强平告警阈值 (名义价值 USDT)
FORCE_ORDER_ALERT_USDT=100000
# 止损保护模式: stop=固定止损 / trailing=追踪止损 (callbackRate 回调触发)
PROTECTION_SL_MODE=stop
# 追踪止损回撤比例 % (0.1-5)
TRAILING_STOP_CALLBACK=1
# 条件单触发基准: CONTRACT_PRICE=最新价(默认) / MARK_PRICE=标记价(防插针误触)
PROTECTION_WORKING_TYPE=CONTRACT_PRICE
# 下单前价格保护: 信号价与现价最大偏差 (默认 0.005 = 0.5%)
MAX_ENTRY_DEVIATION=0.005

# ── 风控补强 (2026-08-16) ──
# 单日最大开仓次数 (0=禁用)
MAX_TRADES_DAY=30
# 最大止损距离 (止损距入场价比例上限, 0=禁用)
MAX_STOP_PCT=0.05
# 保证金率自动减仓阈值 (0=禁用): 超过则平掉保证金占用最大持仓
MARGIN_DELEVERAGE_THRESHOLD=0.8
# 自动减仓动作间隔冷却 (秒), 冷却后仍超阈值继续减
DELEVERAGE_COOLDOWN_SEC=120
# 回撤分级响应减仓档 (0=禁用): 达到即平最大持仓一次, 回撤回落 20% 后重新武装;
# 15% 熔断档由 DrawdownBreaker 负责
DRAWDOWN_REDUCE_TIER=0.12

# ── User Data Stream (成交/余额推送, 2026-08-16 P0) ──
USER_DATA_STREAM=1

# ── 资金费监控 (8h 周期, 超阈值钉钉告警) ──
FUNDING_MONITOR=1
FUNDING_COST_THRESHOLD=1.0
# 资金费记账口径 (2026-08-16 #6):
#   income   默认 — 用 /fapi/v1/income 流水按 tranId 去重精确记账
#   estimate 旧估算口径 (rate × 价值 × 8h), 无流水权限时用
#   off      不记账
FUNDING_ACCOUNTING=income
# income 口径的流水拉取间隔 (秒)
FUNDING_INCOME_INTERVAL_SEC=600
# 流水游标状态文件 (tranId 去重)
FUNDING_INCOME_STATE=data/funding_income_state.json

# ── 持久化与保留策略 ──
DB_PATH=data/trades.db
DB_RETENTION_DAYS=90
# K线历史归档: 1=闭合 K 线持久化到 data/kline.db
KLINE_ARCHIVE=0
KLINE_DB_PATH=data/kline.db

# ── 深度滑点预检 (可选): 1=下单前按吃单深度估算滑点 ──
ORDERBOOK_CHECK=0
MAX_SLIPPAGE_BPS=10

# ── Telegram 远程控制机器人 (python tools/telegram_bot.py) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dashboard ──
DASHBOARD_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
DASHBOARD_INSTANCE=live

# ── 运维历史归档 (看板) ──
OPS_HISTORY_DB=data/ops_history.db
OPS_HISTORY_DAYS=7
# Dashboard 行情条数据源: 1=testnet, 0=实盘
DASHBOARD_TESTNET=1

# ── 钉钉告警 (自定义机器人: 关键词 "SysTrader" + 加签) ──
# 建法: 钉钉群 → 智能群助手 → 添加机器人 → 自定义
DINGTALK_WEBHOOK_URL=
# 兼容旧名 DINGTALK_WEBHOOK (watchdog 兜底读取)
# 创建机器人时选择"加签"安全设置才需要填（自定义关键字则留空）
DINGTALK_SECRET=
# CRITICAL 告警 @ 的手机号 (逗号分隔, 空=不 @人; 2026-08-16 #7)
DINGTALK_AT_MOBILES=

# ── 每日钉钉运营摘要 (2026-08-16 #5) ──
# 每天 DIGEST_HOUR:DIGEST_MINUTE 起 10 分钟内发送一次运行/盈亏/持仓汇总
DIGEST_ENABLED=1
DIGEST_HOUR=8
DIGEST_MINUTE=0

# ── 其他可选 ──
# INTENTS_DB_PATH=data/intents.db      # 幂等跟踪 SQLite 路径
# TIME_OFFSET_LOG=logs/time_offset.jsonl
